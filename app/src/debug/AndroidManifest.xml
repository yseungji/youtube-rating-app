<?xml version="1.0" encoding="utf-8"?>
<!-- 디버그 전용 테스트 Activity의 실행 설정 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Android Studio의 Specified Activity 실행을 디버그 빌드에서만 허용 -->
        <activity
            android:name=".CloudFirestoreActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <!-- 공통 컴포넌트 확인 화면 (아이콘 없음). Android Studio 실행 구성에서 Specified Activity로 연다 -->
        <activity
            android:name=".debug.ComponentGalleryActivity"
            android:exported="true" />
    </application>

</manifest>

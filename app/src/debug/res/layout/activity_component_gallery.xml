<?xml version="1.0" encoding="utf-8"?>
<!-- 공통 컴포넌트 확인 화면 (디버그 빌드 전용). 새 컴포넌트를 만들면 여기에도 하나씩 추가한다. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 화면을 열 때 검색창이 포커스를 가져가 키보드가 뜨지 않도록 바깥 레이아웃이 먼저 포커스를 받는다 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gallery_title"
            android:textAppearance="@style/TextAppearance.Viewit.Display" />

        <!-- 글자 단계 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/gallery_section_text"
            android:textAppearance="@style/TextAppearance.Viewit.Caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/gallery_display"
            android:textAppearance="@style/TextAppearance.Viewit.Display" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/gallery_heading"
            android:textAppearance="@style/TextAppearance.Viewit.Heading" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/gallery_body"
            android:textAppearance="@style/TextAppearance.Viewit.Body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gallery_body_strong"
            android:textAppearance="@style/TextAppearance.Viewit.Body.Strong" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gallery_body_secondary"
            android:textAppearance="@style/TextAppearance.Viewit.Body.Secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gallery_caption"
            android:textAppearance="@style/TextAppearance.Viewit.Caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/gallery_rating"
            android:textAppearance="@style/TextAppearance.Viewit.Body.Strong"
            android:textColor="@color/positive" />

        <!-- 버튼 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/gallery_section_button"
            android:textAppearance="@style/TextAppearance.Viewit.Caption" />

        <Button
            style="@style/Widget.Viewit.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/gallery_button_primary" />

        <Button
            style="@style/Widget.Viewit.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/gallery_button_secondary" />

        <Button
            style="@style/Widget.Viewit.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:enabled="false"
            android:text="@string/gallery_button_disabled" />

        <!-- 칩 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/gallery_section_chip"
            android:textAppearance="@style/TextAppearance.Viewit.Caption" />

        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            app:checkedChip="@id/chip_all"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_all"
                style="@style/Widget.Viewit.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gallery_chip_all" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Viewit.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gallery_chip_education" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Viewit.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gallery_chip_music" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Viewit.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gallery_chip_game" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            app:checkedChip="@id/chip_popular"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_popular"
                style="@style/Widget.Viewit.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gallery_chip_popular" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Viewit.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gallery_chip_rating" />
        </com.google.android.material.chip.ChipGroup>

        <!-- 검색창 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/gallery_section_search"
            android:textAppearance="@style/TextAppearance.Viewit.Caption" />

        <include
            layout="@layout/view_search_field"
            android:layout_width="match_parent"
            android:layout_height="@dimen/search_field_height"
            android:layout_marginTop="@dimen/space_s" />

        <!-- B. 영상 -->
        <TextView
            style="@style/GallerySection"
            android:text="@string/gallery_section_video" />

        <include
            android:id="@+id/gallery_thumbnail"
            layout="@layout/view_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s" />

        <include
            android:id="@+id/gallery_video_row"
            layout="@layout/item_video_row" />

        <include
            android:id="@+id/gallery_category_video"
            layout="@layout/item_category_video" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/gallery_tile_1"
                layout="@layout/item_rating_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/gallery_tile_2"
                layout="@layout/item_rating_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/gallery_tile_3"
                layout="@layout/item_rating_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- C. 사람·리뷰 -->
        <TextView
            style="@style/GallerySection"
            android:text="@string/gallery_section_people" />

        <include
            android:id="@+id/gallery_author"
            layout="@layout/view_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s" />

        <include
            android:id="@+id/gallery_review_actions"
            layout="@layout/view_review_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s" />

        <include
            android:id="@+id/gallery_review_quote"
            layout="@layout/view_review_quote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s" />

        <include
            android:id="@+id/gallery_review_detail"
            layout="@layout/item_review_detail" />

        <include
            android:id="@+id/gallery_user_result"
            layout="@layout/item_user_result" />

        <include
            android:id="@+id/gallery_follow_row"
            layout="@layout/item_follow_row" />

        <include
            android:id="@+id/gallery_library_row"
            layout="@layout/item_library_row" />

        <include
            android:id="@+id/gallery_search_history"
            layout="@layout/item_search_history" />

        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s">

            <com.google.android.material.chip.Chip
                style="@style/Widget.Viewit.Chip.Topic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gallery_chip_music" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Viewit.Chip.Topic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/gallery_topic_animal" />
        </com.google.android.material.chip.ChipGroup>

        <!-- D. 평가 입력 -->
        <TextView
            style="@style/GallerySection"
            android:text="@string/gallery_section_rating" />

        <com.example.viewit.ui.common.RatingPanelView
            android:id="@+id/gallery_rating_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s" />

        <com.example.viewit.ui.common.RatingPanelView
            android:id="@+id/gallery_rating_panel_saved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl" />

        <!-- 평균 별점 0.1점 단위 표시 (StarRatingView) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gallery_avg_label_1"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Viewit.Meta" />

                <com.example.viewit.ui.common.StarRatingView
                    android:id="@+id/gallery_avg_stars_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gallery_avg_label_2"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Viewit.Meta" />

                <com.example.viewit.ui.common.StarRatingView
                    android:id="@+id/gallery_avg_stars_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gallery_avg_label_3"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Viewit.Meta" />

                <com.example.viewit.ui.common.StarRatingView
                    android:id="@+id/gallery_avg_stars_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gallery_avg_label_4"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Viewit.Meta" />

                <com.example.viewit.ui.common.StarRatingView
                    android:id="@+id/gallery_avg_stars_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gallery_avg_label_5"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Viewit.Meta" />

                <com.example.viewit.ui.common.StarRatingView
                    android:id="@+id/gallery_avg_stars_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <com.example.viewit.ui.common.RatingStatisticsView
            android:id="@+id/gallery_rating_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl" />
    </LinearLayout>
</ScrollView>

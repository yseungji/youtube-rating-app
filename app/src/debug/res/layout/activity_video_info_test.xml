<?xml version="1.0" encoding="utf-8"?>
<!-- YouTube 영상 정보 불러오기 확인 화면 (디버그 빌드 전용, 4.1). 영상 ID를 넣고 불러오면 공통 컴포넌트에 실제 정보가 채워진다. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/video_test_title"
            android:textAppearance="@style/TextAppearance.Viewit.Heading" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/video_test_hint"
            android:textAppearance="@style/TextAppearance.Viewit.Meta" />

        <EditText
            android:id="@+id/video_test_input"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_m"
            android:autofillHints=""
            android:background="@drawable/bg_input"
            android:hint="@string/video_test_input_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/space_m"
            android:text="@string/video_test_default_ids"
            android:textAppearance="@style/TextAppearance.Viewit.Body"
            android:textColorHint="@color/text_secondary" />

        <Button
            android:id="@+id/video_test_load"
            style="@style/Widget.Viewit.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/video_test_load" />

        <TextView
            android:id="@+id/video_test_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:textAppearance="@style/TextAppearance.Viewit.Body.Secondary" />

        <include
            android:id="@+id/video_test_thumbnail"
            layout="@layout/view_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m" />

        <LinearLayout
            android:id="@+id/video_test_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/video_test_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:fontFamily="monospace"
            android:textAppearance="@style/TextAppearance.Viewit.Caption"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>

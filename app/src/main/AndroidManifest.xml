<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- YouTube Data API 호출, 썸네일 이미지 불러오기 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11(API 30)+에서 카카오톡 패키지 공유 인텐트 조회 허용 -->
    <queries>
        <package android:name="com.kakao.talk" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Viewit">

        <!-- 앱 시작 화면: 로그인 상태를 확인한 뒤 하단 5탭 표시 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 3.3·3.4 온보딩: 관심 주제 → 평가자 추천 -->
        <activity
            android:name=".ui.onboarding.TopicActivity"
            android:exported="false" />
        <activity
            android:name=".ui.onboarding.RecommendFollowActivity"
            android:exported="false" />

        <!-- 6.3 프로필 편집 (프로필 탭·설정에서 연다) -->
        <activity
            android:name=".ui.profile.ProfileEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 6.2 팔로워·팔로잉 목록과 다른 사용자 프로필 -->
        <activity
            android:name=".ui.profile.FollowListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.profile.UserProfileActivity"
            android:exported="false" />
        <!-- 6.3 설정 → 차단한 사용자 -->
        <activity
            android:name=".ui.profile.BlockedUsersActivity"
            android:exported="false" />

        <!-- 6.1 평가한 영상 목록 (프로필의 평가 숫자에서 연다) -->
        <activity
            android:name=".ui.profile.RatedVideosActivity"
            android:exported="false" />

        <!-- 영상 상세의 평가 입력 화면 -->
        <activity
            android:name=".ui.videodetail.VideoDetailActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
        </activity>

        <!-- 개발용 Firebase 테스트 메뉴. 디버그 빌드에서만 src/debug/AndroidManifest.xml로 아이콘이 생긴다 -->
        <activity
            android:name=".DevMenuActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".CloudFirestoreActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PWAuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- MainActivity에서 미로그인 상태일 때 여는 로그인 화면 -->
        <activity
            android:name=".GoogleSignInActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SignOutActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ProfileSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- 설정 (6.3). 프로필 탭의 설정 버튼에서 연다 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- 시스템 공유 창(Intent.createChooser)에서 선택된 앱 결과를 수신하는 리시버 -->
        <receiver
            android:name=".ui.share.ShareChooserReceiver"
            android:exported="false" />
    </application>

</manifest>

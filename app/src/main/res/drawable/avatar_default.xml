<?xml version="1.0" encoding="utf-8"?>
<!-- 공통 기본 프로필 사진: 그라데이션 원(bg_avatar_default) 위에 사람 모양(ic_avatar_default).
     사진이 없거나 불러오는 중·실패일 때 프로필·피드·팔로워 목록·댓글에서 모두 이 그림을 쓴다.
     예: Glide ... .placeholder(R.drawable.avatar_default).error(...).fallback(...) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_avatar_default" />
    <item android:drawable="@drawable/ic_avatar_default" />
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!-- 기본 프로필 배너: 공개 평가가 하나도 없을 때. 위에서 아래로 연주황 → 더 연한 주황(60%) → 흰색 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerY="0.6"

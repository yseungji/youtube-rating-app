<?xml version="1.0" encoding="utf-8"?>
<!-- 기본 프로필 사진의 사람 모양 (머리 원 + 어깨). 바탕은 bg_avatar_default.
     화면에서는 둘을 겹친 avatar_default를 쓴다. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="80dp"
    android:height="80dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- 어깨가 원 밖으로 나가지 않게 원으로 잘라 낸다 -->
    <group>
        <clip-path android:pathData="M50,0A50,50 0,1 1,50,100A50,50 0,1 1,50,0Z" />
        <!-- 머리 -->
        <path
            android:fillColor="@color/avatar_default_silhouette"
            android:pathData="M50,22A17,17 0,1 1,50,56A17,17 0,1 1,50,22Z" />
        <!-- 어깨 -->
        <path
            android:fillColor="@color/avatar_default_silhouette"
            android:pathData="M16,100C16,76 31,62 50,62C69,62 84,76 84,100Z" />
    </group>
</vector>

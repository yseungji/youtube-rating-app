<?xml version="1.0" encoding="utf-8"?>
<!-- 기본 프로필 그림: 사진이 없거나 불러오는 중일 때 보여 준다.
     바탕은 brand_orange_soft, 사람 모양은 그보다 조금 진한 연주황. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="72dp"
    android:height="72dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- 바탕 원 -->
    <path
        android:fillColor="@color/brand_orange_soft"
        android:pathData="M50,0A50,50 0,1 1,50,100A50,50 0,1 1,50,0Z" />

    <!-- 사람 모양 (어깨가 원 밖으로 나가지 않게 원으로 잘라 냄) -->
    <group>
        <clip-path android:pathData="M50,0A50,50 0,1 1,50,100A50,50 0,1 1,50,0Z" />
        <!-- 머리 -->
        <path
            android:fillColor="#FFFFC9A3"
            android:pathData="M50,23A16,16 0,1 1,50,55A16,16 0,1 1,50,23Z" />
        <!-- 어깨 -->
        <path
            android:fillColor="#FFFFC9A3"
            android:pathData="M18,100C18,75 32,61 50,61C68,61 82,75 82,100Z" />
    </group>
</vector>

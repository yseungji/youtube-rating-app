<?xml version="1.0" encoding="utf-8"?>
<!-- 앱 첫 화면: 위쪽은 탭 화면(Fragment)이 바뀌는 영역, 아래쪽은 하단 5탭 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 좌우 스와이프로 5탭을 전환하는 ViewPager2. 안쪽 가로 스크롤(카테고리 칩·프로필 내부 탭)과 충돌을 막아 준다 -->
    <com.example.viewit.ui.common.SwipeablePagerContainer
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/main_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.example.viewit.ui.common.SwipeablePagerContainer>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/border_default" />

    <!-- Figma 하단 탭은 그림자 없는 흰 바탕. elevation이 있으면 Material3가 회색을 섞어서 0으로 둔다 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        app:backgroundTint="@color/bg_surface"
        app:elevation="0dp"
        app:itemActiveIndicatorStyle="@null"
        app:itemIconTint="@color/bottom_nav_item"
        app:itemTextColor="@color/bottom_nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />
</LinearLayout>

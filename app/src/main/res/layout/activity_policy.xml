<?xml version="1.0" encoding="utf-8"?>
<!-- 설정 → 이용약관 / 개인정보처리방침 (6.3). 어느 문서인지는 Intent Extra로 받는다 (PolicyActivity).
     본문 속 주소는 누르면 브라우저로 열린다 (autoLink). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    android:orientation="vertical">

    <!-- App bar: ← + 제목 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_xs">

        <include
            android:id="@+id/policy_back"
            layout="@layout/view_back_button" />

        <TextView
            android:id="@+id/policy_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Viewit.Heading"
            tools:text="@string/policy_terms_title" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/border_default" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/policy_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoLink="web"
            android:lineSpacingExtra="4dp"
            android:padding="@dimen/screen_padding"
            android:textAppearance="@style/TextAppearance.Viewit.Body"
            android:textIsSelectable="true"
            tools:text="@string/policy_terms_body" />
    </ScrollView>
</LinearLayout>

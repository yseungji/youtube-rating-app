<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    tools:context=".ProfileSetupActivity">

    <!-- 상단: 뒤로가기 · 진행 막대 · 1 / 3 -->
    <include
        android:id="@+id/profile_back_button"
        layout="@layout/view_back_button"
        android:layout_width="@dimen/button_height"
        android:layout_height="@dimen/button_height"
        android:layout_marginStart="@dimen/space_s"
        android:layout_marginTop="@dimen/space_s"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/onboarding_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_m"
        android:max="3"
        android:progress="1"
        app:indicatorColor="@color/brand_orange"
        app:trackColor="@color/action_soft"
        app:trackCornerRadius="2dp"
        app:trackThickness="4dp"
        app:layout_constraintBottom_toBottomOf="@id/profile_back_button"
        app:layout_constraintEnd_toStartOf="@id/step_text"
        app:layout_constraintStart_toEndOf="@id/profile_back_button"
        app:layout_constraintTop_toTopOf="@id/profile_back_button" />

    <TextView
        android:id="@+id/step_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/screen_padding"
        android:text="@string/onboarding_step_1"
        android:textAppearance="@style/TextAppearance.Viewit.Caption"
        app:layout_constraintBottom_toBottomOf="@id/profile_back_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/profile_back_button" />

    <!-- 입력 영역: 키보드가 올라와도 스크롤되게 -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/profile_next_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profile_back_button">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_xl"
            android:paddingTop="@dimen/space_l"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_setup_title"
                android:textAppearance="@style/TextAppearance.Viewit.Display" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/profile_setup_subtitle"
                android:textAppearance="@style/TextAppearance.Viewit.Body.Secondary" />

            <!-- 아바타: 기본 그림. Google 사진이 있으면 코드에서 이 자리에 불러온다 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/avatar_image"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@string/profile_setup_photo_title"
                    android:src="@drawable/ic_avatar_default"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_l"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_setup_photo_title"
                        android:textAppearance="@style/TextAppearance.Viewit.Body.Strong" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/profile_setup_photo_desc"
                        android:textAppearance="@style/TextAppearance.Viewit.Caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- 이름 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/profile_setup_name_label"
                android:textAppearance="@style/TextAppearance.Viewit.Caption" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/name_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:boxCornerRadiusBottomEnd="@dimen/radius_m"
                app:boxCornerRadiusBottomStart="@dimen/radius_m"
                app:boxCornerRadiusTopEnd="@dimen/radius_m"
                app:boxCornerRadiusTopStart="@dimen/radius_m"
                app:boxStrokeColor="@color/brand_orange"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 아이디 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/profile_setup_username_label"
                android:textAppearance="@style/TextAppearance.Viewit.Caption" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/username_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:boxCornerRadiusBottomEnd="@dimen/radius_m"
                app:boxCornerRadiusBottomStart="@dimen/radius_m"
                app:boxCornerRadiusTopEnd="@dimen/radius_m"
                app:boxCornerRadiusTopStart="@dimen/radius_m"
                app:boxStrokeColor="@color/brand_orange"
                app:hintEnabled="false"
                app:prefixText="@">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/username_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textNoSuggestions"
                    android:maxLength="20"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 한줄 소개 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/profile_setup_intro_label"
                android:textAppearance="@style/TextAppearance.Viewit.Caption" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/intro_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:boxCornerRadiusBottomEnd="@dimen/radius_m"
                app:boxCornerRadiusBottomStart="@dimen/radius_m"
                app:boxCornerRadiusTopEnd="@dimen/radius_m"
                app:boxCornerRadiusTopStart="@dimen/radius_m"
                app:boxStrokeColor="@color/brand_orange"
                app:counterEnabled="true"
                app:counterMaxLength="40"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/intro_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/profile_setup_intro_hint"
                    android:inputType="text"
                    android:maxLength="40"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 다음 (주황) -->
    <Button
        android:id="@+id/profile_next_button"
        style="@style/Widget.Viewit.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_xl"
        android:layout_marginBottom="@dimen/space_xl"
        android:text="@string/profile_setup_next"
        app:backgroundTint="@color/brand_orange"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

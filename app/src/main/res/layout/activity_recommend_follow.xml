<?xml version="1.0" encoding="utf-8"?>
<!-- 온보딩 D · 평가자 추천 (3.4, Figma 193:1429). 고른 주제를 자주 평가하는 사람 목록 + 모두 팔로우 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface">

    <!-- 상단: 뒤로가기 · 진행 막대 · 3 / 3 -->
    <include
        android:id="@+id/recommend_back"
        layout="@layout/view_back_button"
        android:layout_width="@dimen/button_height"
        android:layout_height="@dimen/button_height"
        android:layout_marginStart="@dimen/space_s"
        android:layout_marginTop="@dimen/space_s"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/recommend_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_m"
        android:max="3"
        android:progress="3"
        app:indicatorColor="@color/brand_orange"
        app:layout_constraintBottom_toBottomOf="@id/recommend_back"
        app:layout_constraintEnd_toStartOf="@id/recommend_step"
        app:layout_constraintStart_toEndOf="@id/recommend_back"
        app:layout_constraintTop_toTopOf="@id/recommend_back"
        app:trackColor="@color/action_soft"
        app:trackCornerRadius="2dp"
        app:trackThickness="4dp" />

    <TextView
        android:id="@+id/recommend_step"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/screen_padding"
        android:text="@string/onboarding_step_3"
        android:textAppearance="@style/TextAppearance.Viewit.Caption"
        app:layout_constraintBottom_toBottomOf="@id/recommend_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/recommend_back" />

    <TextView
        android:id="@+id/recommend_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_xl"
        android:layout_marginTop="@dimen/space_l"
        android:text="@string/recommend_title"
        android:textAppearance="@style/TextAppearance.Viewit.Display"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recommend_back" />

    <TextView
        android:id="@+id/recommend_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:text="@string/recommend_subtitle"
        android:textAppearance="@style/TextAppearance.Viewit.Body.Secondary"
        app:layout_constraintEnd_toEndOf="@id/recommend_title"
        app:layout_constraintStart_toStartOf="@id/recommend_title"
        app:layout_constraintTop_toBottomOf="@id/recommend_title" />

    <!-- "N명 팔로우 중" · 모두 팔로우 -->
    <TextView
        android:id="@+id/recommend_following_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:textAppearance="@style/TextAppearance.Viewit.Caption"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/recommend_follow_all"
        app:layout_constraintStart_toStartOf="@id/recommend_title"
        app:layout_constraintTop_toBottomOf="@id/recommend_subtitle"
        tools:text="2명 팔로우 중" />

    <TextView
        android:id="@+id/recommend_follow_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:padding="@dimen/space_xs"
        android:text="@string/recommend_follow_all"
        android:textAppearance="@style/TextAppearance.Viewit.Body.Strong"
        android:textColor="@color/brand_orange"
        app:layout_constraintBaseline_toBaselineOf="@id/recommend_following_count"
        app:layout_constraintEnd_toEndOf="@id/recommend_title" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recommend_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_s"
        android:paddingHorizontal="@dimen/space_xl"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/recommend_start_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recommend_following_count"
        tools:listitem="@layout/item_follow_row" />

    <TextView
        android:id="@+id/recommend_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:gravity="center"
        android:text="@string/recommend_empty"
        android:textAppearance="@style/TextAppearance.Viewit.Body.Secondary"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/recommend_title"
        app:layout_constraintStart_toStartOf="@id/recommend_title"
        app:layout_constraintTop_toBottomOf="@id/recommend_following_count" />

    <ProgressBar
        android:id="@+id/recommend_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recommend_following_count" />

    <!-- viewit 시작하기 (주황) · 나중에 할게요 -->
    <Button
        android:id="@+id/recommend_start_button"
        style="@style/Widget.Viewit.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_xl"
        android:layout_marginBottom="@dimen/space_s"
        android:text="@string/recommend_start"
        android:textColor="@color/onboarding_button_text"
        app:backgroundTint="@color/onboarding_button_bg"
        app:layout_constraintBottom_toTopOf="@id/recommend_later"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/recommend_later"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/button_height"
        android:layout_marginBottom="@dimen/space_s"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:paddingHorizontal="@dimen/space_l"
        android:text="@string/recommend_later"
        android:textAppearance="@style/TextAppearance.Viewit.Body.Secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

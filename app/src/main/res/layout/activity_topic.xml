<?xml version="1.0" encoding="utf-8"?>
<!-- 온보딩 C · 관심 주제 고르기 (3.3, Figma 193:1376). 3개 이상 고르면 "다음 (N개 선택)"이 켜진다 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface">

    <!-- 상단: 뒤로가기 · 진행 막대 · 2 / 3 -->
    <include
        android:id="@+id/topic_back"
        layout="@layout/view_back_button"
        android:layout_width="@dimen/button_height"
        android:layout_height="@dimen/button_height"
        android:layout_marginStart="@dimen/space_s"
        android:layout_marginTop="@dimen/space_s"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/topic_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_m"
        android:max="3"
        android:progress="2"
        app:indicatorColor="@color/brand_orange"
        app:layout_constraintBottom_toBottomOf="@id/topic_back"
        app:layout_constraintEnd_toStartOf="@id/topic_step"
        app:layout_constraintStart_toEndOf="@id/topic_back"
        app:layout_constraintTop_toTopOf="@id/topic_back"
        app:trackColor="@color/action_soft"
        app:trackCornerRadius="2dp"
        app:trackThickness="4dp" />

    <TextView
        android:id="@+id/topic_step"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/screen_padding"
        android:text="@string/onboarding_step_2"
        android:textAppearance="@style/TextAppearance.Viewit.Caption"
        app:layout_constraintBottom_toBottomOf="@id/topic_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/topic_back" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/topic_next_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topic_back">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_xl"
            android:paddingTop="@dimen/space_l"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/topic_title"
                android:textAppearance="@style/TextAppearance.Viewit.Display" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/topic_subtitle"
                android:textAppearance="@style/TextAppearance.Viewit.Body.Secondary" />

            <!-- 칩은 TopicActivity가 TopicCatalog 순서대로 넣는다 -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/topic_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                app:chipSpacingHorizontal="@dimen/space_s"
                app:chipSpacingVertical="@dimen/space_s" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/topic_footnote"
                android:textAppearance="@style/TextAppearance.Viewit.Caption" />
        </LinearLayout>
    </ScrollView>

    <!-- 다음 (주황, 3개 미만이면 회색으로 막힘) -->
    <Button
        android:id="@+id/topic_next_button"
        style="@style/Widget.Viewit.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_xl"
        android:layout_marginBottom="@dimen/space_xl"
        android:enabled="false"
        android:text="@string/topic_next"
        android:textColor="@color/onboarding_button_text"
        app:backgroundTint="@color/onboarding_button_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="다음 (4개 선택)" />
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 06 영상 상세의 평가 입력 영역. 공통 RatingPanelView를 재사용한다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    tools:context=".VideoDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_s">

        <include
            android:id="@+id/video_back"
            layout="@layout/view_back_button"
            android:layout_width="@dimen/button_height"
            android:layout_height="@dimen/button_height" />

        <TextView
            android:id="@+id/video_detail_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_s"
            android:text="@string/video_detail_title"
            android:textAppearance="@style/TextAppearance.Viewit.Section" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/border_default" />

    <!-- 영상 영역은 스크롤 밖에 두어 고정한다. 재생 연동 시 이 영역을 플레이어로 교체한다. -->
    <ImageView
        android:id="@+id/video_thumbnail"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@color/action_soft"
        android:contentDescription="@string/video_detail_thumbnail"
        android:scaleType="centerCrop" />

    <!-- 하나의 목록: 위쪽 정보 → Firebase 평가 행들 → 로딩·오류 안내. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/public_rating_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        tools:listitem="@layout/item_review_detail" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 06 영상 상세의 평가 입력 영역. 공통 RatingPanelView를 재사용한다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    tools:context=".VideoDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_s">

        <include
            android:id="@+id/video_back"
            layout="@layout/view_back_button"
            android:layout_width="@dimen/button_height"
            android:layout_height="@dimen/button_height" />

        <TextView
            android:id="@+id/video_detail_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_s"
            android:text="@string/video_detail_title"
            android:textAppearance="@style/TextAppearance.Viewit.Section" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/border_default" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/video_detail_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/video_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@color/action_soft"
                android:contentDescription="@string/video_detail_thumbnail"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding">

                <TextView
                    android:id="@+id/video_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/video_detail_loading"
                    android:textAppearance="@style/TextAppearance.Viewit.Heading" />

                <TextView
                    android:id="@+id/video_channel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:textAppearance="@style/TextAppearance.Viewit.Body.Secondary" />

                <TextView
                    android:id="@+id/video_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:textAppearance="@style/TextAppearance.Viewit.Caption" />

                <TextView
                    android:id="@+id/video_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.Viewit.Caption" />

                <Button
                    android:id="@+id/video_open_youtube"
                    style="@style/Widget.Viewit.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/video_detail_open_youtube" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_s"
                android:background="@color/action_soft" />

            <TextView
                android:id="@+id/my_rating_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/screen_padding"
                android:textAppearance="@style/TextAppearance.Viewit.Body.Secondary"
                android:visibility="gone" />

            <Button
                android:id="@+id/my_rating_retry"
                style="@style/Widget.Viewit.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:text="@string/video_detail_rating_retry"
                android:visibility="gone" />

            <com.example.viewit.ui.common.RatingPanelView
                android:id="@+id/rating_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/screen_padding" />

            <LinearLayout
                android:id="@+id/my_rating_delete_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding"
                android:paddingBottom="@dimen/screen_padding"
                android:visibility="gone">

                <Button
                    android:id="@+id/my_rating_delete"
                    style="@style/Widget.Viewit.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/video_detail_delete"
                    android:textColor="@color/negative" />

            </LinearLayout>

            <!-- 기존 공통 통계 컴포넌트: 공개 평가 전체의 평균·개수·분포를 표시한다. -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_s"
                android:background="@color/action_soft" />

            <ProgressBar
                android:id="@+id/public_rating_loading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_margin="@dimen/space_m"
                android:contentDescription="@string/video_detail_public_loading"
                android:visibility="gone" />

            <TextView
                android:id="@+id/public_rating_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/screen_padding"
                android:text="@string/video_detail_public_idle"
                android:textAppearance="@style/TextAppearance.Viewit.Body.Secondary" />

            <com.example.viewit.ui.common.RatingStatisticsView
                android:id="@+id/public_rating_statistics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_s"
                android:background="@color/action_soft" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/screen_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/video_detail_public_heading"
                    android:textAppearance="@style/TextAppearance.Viewit.Section" />

                <TextView
                    android:id="@+id/public_rating_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:textColor="@color/positive"
                    android:textAppearance="@style/TextAppearance.Viewit.Section"
                    tools:text="2" />
            </LinearLayout>

            <Button
                android:id="@+id/public_rating_refresh"
                style="@style/Widget.Viewit.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding"
                android:text="@string/video_detail_public_refresh" />

            <TextView
                android:id="@+id/public_rating_list_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/screen_padding"
                android:textAppearance="@style/TextAppearance.Viewit.Body.Secondary"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/public_rating_list_loading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_margin="@dimen/space_m"
                android:contentDescription="@string/video_detail_public_list_loading"
                android:visibility="gone" />

            <!-- 상세 안의 목록도 페이징하며, 전체 보기에서는 화면 전체 높이로 탐색한다. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/public_rating_list"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:nestedScrollingEnabled="true"
                tools:listitem="@layout/item_review_detail" />

            <Button
                android:id="@+id/public_rating_all"
                style="@style/Widget.Viewit.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/screen_padding"
                android:text="@string/video_detail_all_reviews" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

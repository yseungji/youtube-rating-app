<?xml version="1.0" encoding="utf-8"?>
<!-- 전체 평가 화면: RecyclerView가 남은 화면을 채워 한 곳에서 페이징 스크롤한다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    android:orientation="vertical"
    tools:context=".ui.rate.VideoRatingsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_s">
        <include
            android:id="@+id/reviews_back"
            layout="@layout/view_back_button"
            android:layout_width="@dimen/button_height"
            android:layout_height="@dimen/button_height" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/video_detail_all_reviews_title"
            android:textAppearance="@style/TextAppearance.Viewit.Section" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/border_default" />

    <Button
        android:id="@+id/reviews_refresh"
        style="@style/Widget.Viewit.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/screen_padding"
        android:text="@string/video_detail_public_refresh" />

    <ProgressBar
        android:id="@+id/reviews_loading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@string/video_detail_public_list_loading"
        android:visibility="gone" />

    <TextView
        android:id="@+id/reviews_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding"
        android:textAppearance="@style/TextAppearance.Viewit.Body.Secondary"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/reviews_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        tools:listitem="@layout/item_review_detail" />
</LinearLayout>

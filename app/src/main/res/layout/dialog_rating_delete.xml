<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 06-D: 다이얼로그 창 자체는 MaterialAlertDialogBuilder가 화면 중앙에 표시한다.
     이 XML은 제목·안내·버튼만 담당한다. 취소는 데이터에 영향을 주지 않는다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rating_delete_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_xl">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/video_detail_delete_dialog_title"
        android:textAppearance="@style/TextAppearance.Viewit.Heading" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:text="@string/video_detail_delete_dialog_message"
        android:textAppearance="@style/TextAppearance.Viewit.Body.Secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/space_xl"
        android:orientation="horizontal">

        <Button
            android:id="@+id/rating_delete_cancel"
            style="@style/Widget.Viewit.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/space_m"
            android:layout_weight="1"
            android:text="@string/video_detail_delete_cancel"
            app:cornerRadius="@dimen/radius_s" />

        <Button
            android:id="@+id/rating_delete_confirm"
            style="@style/Widget.Viewit.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/video_detail_delete_confirm"
            app:backgroundTint="@color/negative"
            app:cornerRadius="@dimen/radius_s" />
    </LinearLayout>
</LinearLayout>

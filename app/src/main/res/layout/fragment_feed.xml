<?xml version="1.0" encoding="utf-8"?>
<!-- 피드 탭 화면 뼈대. 내용: 팔로우한 사람의 최신 평가 (5.3 유승지) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 상단 제목 (Figma App bar, 높이 64dp) -->
    <TextView
        android:id="@+id/feed_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_bar_height"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:text="@string/tab_feed"
        android:textAppearance="@style/TextAppearance.Viewit.Display" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/border_default" />

    <!-- 담당자가 화면 내용을 넣을 영역 -->
    <FrameLayout
        android:id="@+id/feed_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>

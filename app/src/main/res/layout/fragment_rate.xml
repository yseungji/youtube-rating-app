<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 04 평가하기 탭 (5.1).
     앱에서 본 · 좋아요 · 구독 채널 3개 필터 칩이 동일한 섹션 헤더와 1열 영상 목록 구조를 공유한다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    android:orientation="vertical">

    <!-- 제목 줄 없음 (Figma B · 인스타식): "본 영상에 나만의 평가를 남겨보세요"가 맨 위 -->
    <!-- 인트로 · 필터 칩 3개 · 섹션 제목 줄 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="@dimen/space_l">

        <TextView
            android:id="@+id/rate_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rate_intro"
            android:textAppearance="@style/TextAppearance.Viewit.Heading" />


        <!-- 안드로이드에서 제공하는 칩 3개 디자인이 있다.: 필터 칩 3개: 앱에서 본 · 좋아요 · 구독 채널 (하나만 선택, 해제 불가) -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/rate_tab_chip_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            app:checkedChip="@id/chip_rate_watched"
            app:chipSpacingHorizontal="@dimen/space_s"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_rate_watched"
                style="@style/Widget.Viewit.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rate_filter_watched" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_rate_liked"
                style="@style/Widget.Viewit.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rate_filter_liked" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_rate_subscribed"
                style="@style/Widget.Viewit.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rate_filter_subscribed" />
        </com.google.android.material.chip.ChipGroup>

        <!-- 섹션 제목 + 정렬 기준 (3개 탭 공통 구조) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginBottom="@dimen/space_s"
            android:gravity="center_vertical"
            android:minHeight="@dimen/rate_section_min_height"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rate_section_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rate_recent_videos"
                android:textAppearance="@style/TextAppearance.Viewit.Rate.Subheading" />

            <TextView
                android:id="@+id/rate_section_sort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rate_sort_recent"
                android:textAppearance="@style/TextAppearance.Viewit.Caption" />
        </LinearLayout>
    </LinearLayout>

    <!-- 공통 영상 목록 영역 (당겨서 새로고침 + RecyclerView + 로딩/안내 문구) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/rate_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rate_video_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/screen_padding"
                android:paddingBottom="@dimen/space_l"
                tools:itemCount="4"
                tools:listitem="@layout/item_rate_component" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <ProgressBar
            android:id="@+id/rate_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/rate_status_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_xl"
            android:visibility="gone">

            <TextView
                android:id="@+id/rate_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Viewit.Body.Secondary"
                tools:text="@string/rate_watched_empty" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rate_connect_button"
                style="@style/Widget.Viewit.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/rate_connect_youtube"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

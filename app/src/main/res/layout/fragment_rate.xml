<?xml version="1.0" encoding="utf-8"?>
<!-- 평가하기 탭. Firestore의 공개 평가를 RecyclerView에 페이지 단위로 표시한다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    android:orientation="vertical">

    <TextView
        android:id="@+id/rate_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_bar_height"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:text="@string/tab_rate"
        android:textAppearance="@style/TextAppearance.Viewit.Display" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/border_default" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rate_ratings_heading"
            android:textAppearance="@style/TextAppearance.Viewit.Heading" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/rate_ratings_order"
            android:textAppearance="@style/TextAppearance.Viewit.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rate_refresh"
            style="@style/Widget.Viewit.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/rate_refresh" />

        <ProgressBar
            android:id="@+id/rate_loading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/rate_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:accessibilityLiveRegion="polite"
            android:text="@string/rate_loading"
            android:textAppearance="@style/TextAppearance.Viewit.Body.Secondary" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rate_video_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_l"
        android:clipToPadding="false"
        tools:listitem="@layout/item_rating"
        tools:itemCount="4" />
</LinearLayout>

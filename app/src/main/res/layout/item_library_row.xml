<?xml version="1.0" encoding="utf-8"?>
<!-- 보관함 목록 한 줄 (Figma UI4/LibraryRow): 회색 아이콘 상자 + 이름 + 오른쪽 화살표. 예: "나중에 볼 동영상" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_m">

    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_icon_box">

        <ImageView
            android:id="@+id/library_row_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_bookmark_outline"
            app:tint="@color/text_primary" />
    </FrameLayout>

    <TextView
        android:id="@+id/library_row_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Viewit.Title"
        tools:text="나중에 볼 동영상" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/text_secondary" />
</LinearLayout>

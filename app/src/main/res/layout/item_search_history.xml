<?xml version="1.0" encoding="utf-8"?>
<!-- 최근 검색어 한 줄 (Figma UI4/SearchHistoryRow): 시계 아이콘 + 검색어 + 지우기(X) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_m"
    android:paddingEnd="@dimen/space_xs">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_history"
        app:tint="@color/text_secondary" />

    <TextView
        android:id="@+id/search_history_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Viewit.Body"
        android:textSize="15sp"
        tools:text="방 정리" />

    <Button
        android:id="@+id/search_history_delete"
        style="@style/Widget.Viewit.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/delete_search_history"
        app:icon="@drawable/ic_close" />
</LinearLayout>

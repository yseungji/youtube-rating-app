<?xml version="1.0" encoding="utf-8"?>
<!-- 목록 맨 아래에서 다음 페이지 로딩·오류·빈 목록과 재시도를 안내한다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/public_rating_list_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding"
        android:textAppearance="@style/TextAppearance.Viewit.Body.Secondary"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/public_rating_list_loading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_margin="@dimen/space_m"
        android:contentDescription="@string/video_detail_public_list_loading"
        android:visibility="gone" />

    <Button
        android:id="@+id/public_rating_retry"
        style="@style/Widget.Viewit.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:text="@string/video_detail_public_refresh"
        android:visibility="gone" />
</LinearLayout>

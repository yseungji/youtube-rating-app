<?xml version="1.0" encoding="utf-8"?>
<!-- 영상 한 줄 (Figma UI4/VideoRow). 평가하기 탭의 최근 본 영상, 검색 결과 등에서 사용.
     "평가하기 →"가 필요 없으면 R.id.video_row_action을 GONE으로 둔다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/space_l">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/video_row_thumbnail"
        android:layout_width="112dp"
        android:layout_height="63dp"
        android:contentDescription="@string/thumbnail_description"
        android:scaleType="centerCrop"
        android:src="@color/action_soft"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Viewit.Thumbnail.Small" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/video_row_title"
            android:lineBreakWordStyle="phrase"
            tools:targetApi="33"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Viewit.Title"
            tools:text="집에서 만드는 나폴리 피자, 오븐 없이 프라이팬으로 끝내기" />

        <TextView
            android:id="@+id/video_row_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Viewit.Meta"
            tools:text="요리하는 사람들 · 12분 30초" />

        <TextView
            android:id="@+id/video_row_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/video_rate_action"
            android:textAppearance="@style/TextAppearance.Viewit.Label" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- RatingPanelView 내부 화면 (Figma UI4/RatingPanel). 직접 include하지 말고
     <com.example.viewit.ui.common.RatingPanelView />로 사용한다. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rating_panel_title"
        android:textAppearance="@style/TextAppearance.Viewit.Section" />

    <TextView
        android:id="@+id/rating_panel_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:text="@string/rating_panel_hint_editing"
        android:textAppearance="@style/TextAppearance.Viewit.Caption"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.example.viewit.ui.common.StarRatingInputView
            android:id="@+id/rating_panel_stars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/rating_panel_score_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:textAppearance="@style/TextAppearance.Viewit.Rating"
            android:textSize="12sp"
            tools:text="4점 · 좋아요" />
    </LinearLayout>

    <EditText
        android:id="@+id/rating_panel_comment"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/space_m"
        android:autofillHints=""
        android:background="@drawable/bg_input"
        android:hint="@string/rating_comment_hint"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/space_m"
        android:textAppearance="@style/TextAppearance.Viewit.Body"
        android:textColorHint="@color/text_secondary" />

    <include
        android:id="@+id/rating_panel_visibility"
        layout="@layout/view_visibility_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:orientation="horizontal">

        <Button
            android:id="@+id/rating_panel_watch_later"
            style="@style/Widget.Viewit.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_s"
            android:layout_weight="1"
            android:text="@string/add_to_watch_later" />

        <Button
            android:id="@+id/rating_panel_save"
            style="@style/Widget.Viewit.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/rating_save" />
    </LinearLayout>
</merge>

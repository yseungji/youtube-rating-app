<?xml version="1.0" encoding="utf-8"?>
<!-- 리뷰 반응 버튼 줄 (Figma UI4/ReviewActions): 좋아요 · 댓글 · 공유 · 나중에 보기.
     좋아요를 누른 상태는 R.drawable.ic_heart(코랄), 나중에 보기에 담은 상태는 R.drawable.ic_bookmark로 바꾼다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/review_action_like"
        style="@style/Widget.Viewit.ReviewAction"
        app:drawableStartCompat="@drawable/ic_heart_outline"
        tools:text="좋아요 2" />

    <TextView
        android:id="@+id/review_action_comment"
        style="@style/Widget.Viewit.ReviewAction"
        android:text="@string/review_comment"
        app:drawableStartCompat="@drawable/ic_comment" />

    <TextView
        android:id="@+id/review_action_share"
        style="@style/Widget.Viewit.ReviewAction"
        android:text="@string/review_share"
        app:drawableStartCompat="@drawable/ic_share" />

    <TextView
        android:id="@+id/review_action_watch_later"
        style="@style/Widget.Viewit.ReviewAction"
        android:layout_marginEnd="0dp"
        android:text="@string/review_watch_later"
        app:drawableStartCompat="@drawable/ic_bookmark_outline" />
</LinearLayout>

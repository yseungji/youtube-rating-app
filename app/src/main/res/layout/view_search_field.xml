<?xml version="1.0" encoding="utf-8"?>
<!-- 공통 검색창 (Figma UI4/SearchField). 다른 화면에서 <include layout="@layout/view_search_field" />로 넣고
     입력값은 R.id.search_input으로 읽는다. 안내 문구를 바꾸려면 setHint()를 쓴다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/search_field_height"
    android:background="@drawable/bg_search_field"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_m">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_tab_search"
        app:tint="@color/text_secondary" />

    <EditText
        android:id="@+id/search_input"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/space_s"
        android:layout_weight="1"
        android:autofillHints=""
        android:background="@null"
        android:hint="@string/search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Viewit.Body"
        android:textColorHint="@color/text_secondary" />

    <!-- 검색어 지우기(X). 기본은 숨김이라 이 검색창을 쓰는 다른 화면에는 영향이 없다.
         쓰는 화면에서 입력이 있을 때만 보이고, 누르면 search_input을 비운다 (탐색 탭 SearchFragment) -->
    <Button
        android:id="@+id/search_clear"
        style="@style/Widget.Viewit.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="-8dp"
        android:contentDescription="@string/search_clear"
        android:visibility="gone"
        app:icon="@drawable/ic_close" />
</LinearLayout>

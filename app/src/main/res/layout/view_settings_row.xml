<?xml version="1.0" encoding="utf-8"?>
<!-- 설정 한 줄 (Figma 10 · 설정의 Settings row): 아이콘 칸 · 제목(+설명) · 값 · 화살표.
     아이콘·글자·값은 SettingsActivity.bindRow()에서 넣는다. 설명·값·화살표는 필요할 때만 보인다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_m"
    android:paddingVertical="@dimen/space_m">

    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_settings_icon">

        <ImageView
            android:id="@+id/row_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/text_primary"
            tools:src="@drawable/ic_person_outline" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Viewit.Body.Strong"
            android:textSize="15sp"
            tools:text="@string/settings_profile_edit" />

        <TextView
            android:id="@+id/row_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Viewit.Caption"
            android:visibility="gone"
            tools:text="@string/settings_profile_edit_desc"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.Viewit.Caption"
        android:visibility="gone"
        tools:text="1.0" />

    <ImageView
        android:id="@+id/row_chevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="@dimen/space_s"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/text_secondary" />
</LinearLayout>

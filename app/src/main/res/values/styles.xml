<?xml version="1.0" encoding="utf-8"?>
<!-- 공통 위젯 스타일 (Figma UI4/Button, UI4/Chip). 레이아웃에서 style="@style/..."로 쓴다. -->
<resources>
    <!-- 검정 버튼 (평가하기·평가 저장 등 주요 행동). 높이 48, 모서리 12 -->
    <style name="Widget.Viewit.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="android:textAppearance">@style/TextAppearance.Viewit.Button</item>
    </style>

    <!-- 흰 테두리 버튼 (보관함에 담기 등 보조 행동). 높이 48, 모서리 12 -->
    <style name="Widget.Viewit.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/bg_surface</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/border_default</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="android:textAppearance">@style/TextAppearance.Viewit.Button</item>
    </style>

    <!-- 선택 칩 (카테고리·정렬). 기본은 회색 바탕, 선택하면 검정 바탕 흰 글자. 높이 36, 양끝 둥글게 -->
    <style name="Widget.Viewit.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">@dimen/chip_height</item>
        <item name="chipStartPadding">@dimen/space_s</item>
        <item name="chipEndPadding">@dimen/space_s</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="android:textAppearance">@style/TextAppearance.Viewit.Chip</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <!-- 작은 검정 버튼 (사용자 검색 결과의 "팔로우"). 높이 36, 양끝 둥글게 -->
    <style name="Widget.Viewit.Button.Small" parent="Widget.Viewit.Button.Primary">
        <item name="android:minHeight">@dimen/chip_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/space_l</item>
        <item name="android:paddingEnd">@dimen/space_l</item>
        <item name="cornerRadius">999dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Viewit.Label</item>
    </style>

    <!-- 작은 회색 버튼 (이미 팔로우 중인 "팔로잉"). 높이 36, 양끝 둥글게 -->
    <style name="Widget.Viewit.Button.Small.Tonal">
        <item name="backgroundTint">@color/action_soft</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- 아이콘만 있는 버튼 (최근 검색어 지우기, 더보기). 터치 영역 40dp -->
    <style name="Widget.Viewit.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">@color/text_secondary</item>
        <item name="iconSize">20dp</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- 공개 범위 토글 칸 (공개 / 나만 보기). 선택한 칸만 검정 -->
    <style name="Widget.Viewit.Chip.Segment">
        <item name="chipBackgroundColor">@color/segment_bg</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipStartPadding">@dimen/space_xs</item>
        <item name="chipEndPadding">@dimen/space_xs</item>
    </style>

    <!-- 온보딩 관심 주제 칩. 선택하면 연한 주황 바탕 + 주황 테두리 (UI4/TopicChip) -->
    <style name="Widget.Viewit.Chip.Topic">
        <item name="chipBackgroundColor">@color/topic_chip_bg</item>
        <item name="chipStrokeColor">@color/topic_chip_stroke</item>
        <item name="chipStrokeWidth">1.5dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipMinHeight">42dp</item>
        <item name="chipStartPadding">@dimen/space_m</item>
        <item name="chipEndPadding">@dimen/space_m</item>
        <item name="android:textAppearance">@style/TextAppearance.Viewit.Body</item>
    </style>

    <!-- 이니셜 아바타 (UI4/Author). 지름 40, 회색 원 안에 이름 첫 글자 -->
    <style name="Widget.Viewit.Avatar" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_avatar</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.Viewit.Name</item>
    </style>

    <!-- 리뷰 반응 버튼 (좋아요·댓글·공유·나중에 보기). 아이콘 + 회색 글자 -->
    <style name="Widget.Viewit.ReviewAction" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">@dimen/space_l</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">@style/TextAppearance.Viewit.Meta</item>
        <item name="android:textSize">12sp</item>
        <item name="drawableTint">@color/text_primary</item>
    </style>

    <!-- 썸네일 모서리 10 -->
    <style name="ShapeAppearance.Viewit.Thumbnail" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_s</item>
    </style>

    <!-- 작은 썸네일 모서리 8 (목록 행) -->
    <style name="ShapeAppearance.Viewit.Thumbnail.Small">
        <item name="cornerSize">@dimen/space_s</item>
    </style>

</resources>

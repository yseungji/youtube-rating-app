rules_version = '2';

// Viewit Storage 보안 규칙 (6.4). 프로필 사진만 쓴다 (3.2 프로필 만들기, 6.3 프로필 편집).
service firebase.storage {
  match /b/{bucket}/o {

    // profileImages/{uid}.jpg: 로그인한 사람은 읽기, 본인만 올리기·지우기. 이미지, 2MB 미만
    match /profileImages/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && fileName == request.auth.uid + '.jpg';
    }
  }
}
